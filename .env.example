# Django
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=portalmotionweb.com,www.portalmotionweb.com
CSRF_TRUSTED_ORIGINS=https://portalmotionweb.com,https://www.portalmotionweb.com
TIME_ZONE=Asia/Bishkek

# PostgreSQL
DB_ENGINE=postgresql
DB_POSTGRES=tabel
DB_USER=tabel
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=db
DB_PORT=5432

# Reverse proxy and HTTPS
USE_X_FORWARDED_HOST=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Monthly reports and Dify
AUTO_MONTHLY_REPORTS=False
REPORT_SCHEDULER_RUN_ON_START=True
REPORT_SCHEDULER_INTERVAL_SECONDS=3600
REPORT_LOG_LEVEL=INFO
DIFY_API_KEY=replace-with-dify-api-key
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_RESPONSE_MODE=blocking
DIFY_TIMEOUT_SECONDS=30
DIFY_ACCEPT_PARTIAL_SUCCESS=False
BACKEND_REPORT_CALLBACK_TOKEN=replace-with-at-least-32-random-characters
