# Copy to .env.production on the Ubuntu server; keep the real file out of Git.
# Set permissions to 600 and use unique production credentials.
DB_POSTGRES=replace-with-production-database-name
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-long-random-database-password
SECRET_KEY=replace-with-long-random-django-secret
DIFY_API_KEY=replace-with-production-dify-key
DIFY_API_URL=https://api.dify.ai/v1/workflows/run

ALLOWED_HOSTS=portalmotionweb.com,www.portalmotionweb.com
CSRF_TRUSTED_ORIGINS=https://portalmotionweb.com,https://www.portalmotionweb.com
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SERVE_STATIC_FILES=false

# Name of the external Docker network used by the existing Dify deployment.
DIFY_DOCKER_NETWORK=docker_default

# Verified Docker Hub amd64 image for x86_64 Ubuntu, pinned by manifest digest.
WAHA_PARENT_IMAGE=devlikeapro/waha:latest-2026.9.2@sha256:ecadb467ff9af107e7c235a955cab99ef5a1c13656cbc78aeb3e6b4d30fae7e4
WAHA_PARENT_LOCAL_PORT=3002
WAHA_PARENT_API_KEY=replace-with-unique-parent-waha-api-key
WAHA_PARENT_API_KEY_HASH=sha512:replace-with-hash-of-parent-waha-api-key
WAHA_PARENT_DASHBOARD_USERNAME=admin
WAHA_PARENT_DASHBOARD_PASSWORD=replace-with-unique-dashboard-password
WAHA_PARENT_SESSION=default
WAHA_PARENT_TIMEOUT_SECONDS=30
WAHA_PARENT_SEND_INTERVAL_SECONDS=2
WAHA_PARENT_UNKNOWN_AFTER_SECONDS=300

# Keep disabled until a separately approved live-send window.
WAHA_PARENT_REPORTS_ENABLED=false
WAHA_PARENT_WORKER_ENABLED=false

# Existing test account remains disabled in production.
WAHA_TEST_MODE_ENABLED=false
WAHA_WORKER_ENABLED=false
WAHA_TEST_RECIPIENT=
WAHA_API_KEY=
WAHA_API_KEY_HASH=
WAHA_DASHBOARD_PASSWORD=replace-with-test-dashboard-password
